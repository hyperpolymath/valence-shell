{"id": "vars-10", "rc": 0, "out": "0\n1\n", "cmd": "echo $? ; false; echo $?"}
{"id": "vars-11", "rc": 0, "out": "1\n", "cmd": "echo \"$$\" | grep -c '[0-9]'"}
{"id": "arith-01", "rc": 0, "out": "7\n", "cmd": "echo $((1+2*3))"}
{"id": "arith-02", "rc": 0, "out": "3 49\n", "cmd": "x=7; echo $((x % 4)) $((x ** 2))"}
{"id": "arith-03", "rc": 0, "out": "1\n", "cmd": "i=0; i=$((i+1)); echo $i"}
{"id": "arith-04", "rc": 0, "out": "7\n", "cmd": "((x=3+4)); echo $x"}
{"id": "arith-05", "rc": 0, "out": "10\n", "cmd": "let y=2*5; echo $y"}
{"id": "subst-01", "rc": 0, "out": "nested\n", "cmd": "echo $(echo nested)"}
{"id": "subst-02", "rc": 0, "out": "today: 20\n", "cmd": "echo \"today: $(date +%Y | cut -c1-2)\""}
{"id": "subst-03", "rc": 0, "out": "back\n", "cmd": "x=`echo back`; echo $x"}
{"id": "subst-04", "rc": 0, "out": "deep\n", "cmd": "echo $(echo $(echo deep))"}
{"id": "pipe-01", "rc": 0, "out": "HELLO\n", "cmd": "echo hello | tr a-z A-Z"}
{"id": "pipe-02", "rc": 0, "out": "a\nb\n", "cmd": "printf 'b\\na\\nc\\n' | sort | head -2"}
{"id": "pipe-03", "rc": 0, "out": "3\n", "cmd": "echo hi | cat | cat | wc -c"}
{"id": "pipe-04", "rc": 0, "out": "0\n", "cmd": "false | true; echo $?"}
{"id": "pipe-05", "rc": 0, "out": "15\n", "cmd": "seq 1 5 | awk '{s+=$1} END{print s}'"}
{"id": "redir-01", "rc": 0, "out": "x\n", "cmd": "echo x > f; cat f"}
{"id": "redir-02", "rc": 0, "out": "2\n", "cmd": "echo x > f; echo y >> f; wc -l < f"}
{"id": "redir-03", "rc": 0, "out": "rc=2\n", "cmd": "ls /nonexistent 2>/dev/null; echo rc=$?"}
{"id": "redir-04", "rc": 0, "out": "1\n", "cmd": "ls /nonexistent > out 2>&1; grep -c . out"}
{"id": "redir-05", "rc": 0, "out": "herestring\n", "cmd": "cat <<< \"herestring\""}
{"id": "redir-06", "rc": 0, "out": "ok\n", "cmd": "echo err >&2 2>/dev/null; echo ok"}
{"id": "logic-01", "rc": 0, "out": "yes\n", "cmd": "true && echo yes || echo no"}
{"id": "logic-02", "rc": 0, "out": "no\n", "cmd": "false && echo yes || echo no"}
{"id": "logic-03", "rc": 0, "out": "dir\n", "cmd": "[ -d / ] && echo dir"}
{"id": "logic-04", "rc": 0, "out": "ok\n", "cmd": "[ 3 -gt 2 ] && [ a = a ] && echo ok"}
{"id": "logic-05", "rc": 0, "out": "match\n", "cmd": "[[ abc == a* ]] && echo match"}
{"id": "logic-06", "rc": 0, "out": "file\n", "cmd": "test -f /etc/passwd && echo file"}
{"id": "logic-07", "rc": 0, "out": "negated\n", "cmd": "! false && echo negated"}
{"id": "if-01", "rc": 0, "out": "t\n", "cmd": "if true; then echo t; else echo f; fi"}
{"id": "if-02", "rc": 0, "out": "b\n", "cmd": "if [ 1 -eq 2 ]; then echo a; elif [ 1 -eq 1 ]; then echo b; fi"}
{"id": "if-03", "rc": 0, "out": "big\n", "cmd": "x=3; if (( x > 2 )); then echo big; fi"}
{"id": "loop-01", "rc": 0, "out": "1\n2\n3\n", "cmd": "for i in 1 2 3; do echo $i; done"}
{"id": "loop-02", "rc": 0, "out": "n1\nn2\nn3\n", "cmd": "for i in $(seq 3); do echo n$i; done"}
{"id": "loop-03", "rc": 0, "out": "p1\np2\n", "cmd": "mkdir zzdir; touch zzdir/p1 zzdir/p2; for f in zzdir/p*; do echo ${f##*/}; done"}
{"id": "loop-04", "rc": 0, "out": "3\n", "cmd": "i=0; while [ $i -lt 3 ]; do i=$((i+1)); done; echo $i"}
{"id": "loop-05", "rc": 0, "out": "0\n1\n2\n", "cmd": "for ((i=0;i<3;i++)); do echo $i; done"}
{"id": "loop-06", "rc": 0, "out": "1\n3\n", "cmd": "for i in 1 2 3; do [ $i = 2 ] && continue; echo $i; done"}
{"id": "loop-07", "rc": 0, "out": "1\n", "cmd": "for i in 1 2 3; do [ $i = 2 ] && break; echo $i; done"}
{"id": "loop-08", "rc": 0, "out": "once\n", "cmd": "until false; do echo once; break; done"}
{"id": "loop-09", "rc": 0, "out": "got line\n", "cmd": "while read l; do echo \"got $l\"; done <<< \"line\""}
{"id": "case-01", "rc": 0, "out": "starts\n", "cmd": "case foo in f*) echo starts;; *) echo other;; esac"}
{"id": "case-02", "rc": 0, "out": "ab\n", "cmd": "x=b; case $x in a|b) echo ab;; esac"}
{"id": "func-01", "rc": 0, "out": "in f arg\n", "cmd": "f() { echo \"in f $1\"; }; f arg"}
{"id": "func-02", "rc": 0, "out": "3\n", "cmd": "f() { return 3; }; f; echo $?"}
{"id": "func-03", "rc": 0, "out": "inner\nouter\n", "cmd": "f() { local v=inner; echo $v; }; v=outer; f; echo $v"}
{"id": "func-04", "rc": 0, "out": "g\n", "cmd": "function g { echo g; }; g"}
{"id": "func-05", "rc": 0, "out": "3\n", "cmd": "f() { echo $#; }; f a b c"}
{"id": "func-06", "rc": 0, "out": "120\n", "cmd": "fact() { [ $1 -le 1 ] && echo 1 || echo $(( $1 * $(fact $(($1-1))) )); }; fact 5"}
{"id": "glob-01", "rc": 0, "out": "a.txt b.txt\n", "cmd": "touch a.txt b.txt c.md; echo *.txt"}
{"id": "glob-02", "rc": 0, "out": "a1 a2\n", "cmd": "touch a1 a2 b1; echo a?"}
