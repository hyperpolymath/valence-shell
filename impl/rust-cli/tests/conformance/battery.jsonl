{"id": "basic-01", "rc": 0, "out": "hello\n", "cmd": "echo hello"}
{"id": "basic-02", "rc": 0, "out": "a  b c  d\n", "cmd": "echo \"a  b\"   'c  d'"}
{"id": "basic-03", "rc": 0, "out": "one\ntwo\n", "cmd": "echo one; echo two"}
{"id": "vars-01", "rc": 0, "out": "5\n", "cmd": "x=5; echo $x"}
{"id": "vars-02", "rc": 0, "out": "helloworld\n", "cmd": "x=hello; echo \"${x}world\""}
{"id": "vars-03", "rc": 0, "out": "2\n", "cmd": "x=\"a b\"; echo $x | wc -w"}
