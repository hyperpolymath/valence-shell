{"id": "glob-06", "rc": 0, "out": "1 2 3 4 5\n", "cmd": "echo {1..5}"}
{"id": "quote-01", "rc": 0, "out": "single $x double $x\n", "cmd": "echo 'single $x' \"double \\$x\""}
